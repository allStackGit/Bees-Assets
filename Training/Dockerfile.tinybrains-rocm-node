# Reproducible extension of the operator-qualified Halifax ROCm/PyTorch image.
# The pinned TinyBrains replay analytics invokes the official WASM cartridge
# through scripts/ReplayMetrics.mjs; Python and ROCm alone are insufficient.
# Build explicitly on Halifax:
#   sudo -n /usr/bin/docker build -f Training/Dockerfile.tinybrains-rocm-node \
#     -t tinybrains-rocm:halifax-node .
FROM tinybrains-rocm:halifax
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node -e "if (Number(process.versions.node.split('.')[0]) < 18) process.exit(1)"

# Install the missing ONNX scripting dependency in the exact interpreter
# launched by Experiment Hub. A prior approved Halifax base image may predate
# TinyBrains' dependency additions, even though the current upstream Dockerfile
# already installs onnxscript. Keep the base image's qualified ROCm PyTorch.
RUN /opt/tinybrains-venv/bin/python -m pip install --no-cache-dir \
        'onnxscript==0.7.2'

# TinyBrains exports ONNX opset 17 via the legacy TorchScript path
# (dynamo=False). Check BOTH the onnxscript import that previously failed
# and a real opset-17 export; do not invoke the newer exporter path here,
# which attempts unsupported opset conversion with this ROCm PyTorch.
RUN /opt/tinybrains-venv/bin/python -c \
        'import torch, onnx, onnxscript; torch.onnx.export(torch.nn.Identity().eval(), (torch.zeros(1, 2),), "/tmp/tinybrains-onnx-smoke.onnx", opset_version=17, dynamo=False); assert onnx.load("/tmp/tinybrains-onnx-smoke.onnx").opset_import[0].version == 17' \
    && rm /tmp/tinybrains-onnx-smoke.onnx
